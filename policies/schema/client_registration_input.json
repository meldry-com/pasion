{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClientRegistrationInput",
  "description": "Input for the client registration policy.",
  "type": "object",
  "properties": {
    "client_metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "requester": {
      "$ref": "#/definitions/Requester"
    }
  },
  "required": [
    "client_metadata",
    "requester"
  ],
  "definitions": {
    "Requester": {
      "description": "Identity of the requester",
      "type": "object",
      "properties": {
        "ip_address": {
          "description": "IP address of the entity making the request",
          "type": [
            "string",
            "null"
          ],
          "format": "ip"
        },
        "user_agent": {
          "description": "User agent of the entity making the request",
          "type": [
            "string",
            "null"
          ]
        },
        "country_code": {
          "description": "Country code (ISO 3166-1 alpha-2) derived from the requester's IP address",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}